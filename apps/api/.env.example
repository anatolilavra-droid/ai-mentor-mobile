# Copy to .env (never commit .env). Only names are listed here; never put real secrets in this file.
NODE_ENV=development
PORT=3000
# Interface to listen on; 0.0.0.0 lets the hosting platform reach the server.
HOST=0.0.0.0
LOG_LEVEL=info

# Public values from Supabase → Project Settings → API. Data is protected by Row Level Security.
# Never put the service_role / secret key or the JWT secret here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# AI provider: mock (default, no key, no network) or gemini (free tier, for testing only).
AI_PROVIDER=mock
# Gemini only. Create the key in Google AI Studio; keep it in the platform's secret store.
GEMINI_API_KEY=
# Exact model id from the "AI smoke test" workflow listing (for example a Flash model).
AI_MODEL=
# Comma-separated Supabase user ids that may reach the real provider. Everyone else gets
# the mock, so other people's data never reaches a free-tier provider. Empty = nobody.
AI_REAL_PROVIDER_USER_IDS=
# AI timeouts: chat, and code review (longer structured answers). The whole request
# timeout must be greater than both, so the typed timeout error can still be sent.
AI_TIMEOUT_MS=30000
CODE_REVIEW_AI_TIMEOUT_MS=50000
REQUEST_TIMEOUT_MS=60000

# Fits a 10 000-character message plus the largest allowed history.
JSON_BODY_LIMIT=256kb

# Conversation history sent to the AI (chat/v2): last N messages within a character budget.
CHAT_HISTORY_MAX_MESSAGES=12
CHAT_CONTEXT_MAX_CHARS=24000
CHAT_HISTORY_MESSAGE_MAX_CHARS=4000
RATE_LIMIT_IP_MAX=300
RATE_LIMIT_IP_WINDOW_MS=300000
RATE_LIMIT_AI_MAX=10
RATE_LIMIT_AI_WINDOW_MS=60000

# Number of trusted reverse proxies in front of the server (0 = none, do not trust X-Forwarded-For).
TRUST_PROXY=0
