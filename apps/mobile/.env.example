# Copy to .env (never commit .env) and fill in from Supabase → Project Settings → API.
# Both values are public by design; data is protected by Row Level Security.
# Never put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: https address of the AI Mentor API (for example the Render service URL).
# Public by design. Without it the chat shows "not connected". Never put an AI key here.
EXPO_PUBLIC_API_URL=
